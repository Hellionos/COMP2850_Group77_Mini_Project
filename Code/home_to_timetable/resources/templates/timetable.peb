{% extends "base.peb" %}
{% block title %}Timetable{% endblock %}
{% block main %}

    <h1>Student Timetable</h1>
    <p>Welcome to my timetable website.</p>

    <form action="/timetable" method="get">
        <label for="day">Select a day:</label>

        
<select id="day" name="day">
    <option value="Monday" {% if day == "Monday" %}selected{% endif %}>Monday</option>
    <option value="Tuesday" {% if day == "Tuesday" %}selected{% endif %}>Tuesday</option>
    <option value="Wednesday" {% if day == "Wednesday" %}selected{% endif %}>Wednesday</option>
    <option value="Thursday" {% if day == "Thursday" %}selected{% endif %}>Thursday</option>
    <option value="Friday" {% if day == "Friday" %}selected{% endif %}>Friday</option>
</select>


        <button type="submit">View Timetable</button>
    </form>

    <h2>{{ day }}</h2>

    <table>
        <tr>
            <th>Time</th>
            <th>Module</th>
            <th>Room</th>
        </tr>

        {% for course in courses %}
        <tr>
            <td>{{ course.time }}</td>
            <td>{{ course.module }}</td>
            <td>{{ course.room }}</td>
        </tr>
        {% endfor %}

    </table>

    <form action="/" method="get">
    <button type="submit" class="bottom-btn">Go back to homepage</button>
{% endblock %}
<button class="bottom-btn">Check In</button>